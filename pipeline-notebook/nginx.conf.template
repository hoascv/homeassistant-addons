worker_processes 1;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;

    # Kernels talk over websockets; without this the notebook connects and then
    # hangs with "Connecting to kernel" forever.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen %%INGRESS_PORT%% default_server;

        # Only Home Assistant's ingress may reach this. The port is not
        # published, so this is belt and braces — but the thing behind it runs
        # arbitrary code as root, so belt and braces is warranted.
        allow 172.30.32.2;
        deny all;

        # Notebook uploads and large outputs.
        client_max_body_size 0;

        location / {
            # The heart of it. Home Assistant *strips* the ingress prefix before
            # forwarding, so requests arrive here at `/`. JupyterLab needs that
            # prefix back — its base_url has to match, because base_url is also
            # what it builds every asset and websocket URL from. So nginx adds
            # it again on the way to Jupyter, and the round trip is consistent:
            #
            #   browser  /api/hassio_ingress/TOKEN/lab
            #   HA       ->  /lab
            #   nginx    ->  /api/hassio_ingress/TOKEN/lab
            #   Jupyter  base_url matches, generates the same prefix back
            proxy_pass http://127.0.0.1:%%JUPYTER_PORT%%%%INGRESS_ENTRY%%/;

            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # A kernel can sit idle for a long time between messages.
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_redirect off;
            proxy_buffering off;
        }
    }
}
