worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events {
    worker_connections 256;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;

    # The console opens a websocket for live updates (e.g. object-browser
    # progress); without this map it connects and then just hangs.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 9002 default_server;

        # Only Home Assistant's ingress may reach this. The port is not
        # published, but this fronts admin access to every bucket, so belt
        # and braces is warranted.
        allow 172.30.32.2;
        deny all;

        client_max_body_size 0;

        # MinIO console's own HTML derives everything else it needs — API
        # calls, websocket URLs, static asset paths — from document.baseURI,
        # which this one <base> tag sets. Home Assistant strips the ingress
        # prefix before forwarding, so MinIO itself is asked for plain
        # root-relative paths throughout; this substitution only has to make
        # the browser's *next* requests carry the prefix Home Assistant
        # expects to see again. Confirmed against a running console: without
        # it, every asset and API call 404s under the ingress path.
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '<base href="/"/>' '<base href="%%INGRESS_ENTRY%%/"/>';

        location / {
            proxy_pass http://127.0.0.1:9001/;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # sub_filter can only rewrite what it can read; MinIO would
            # otherwise gzip the HTML this depends on.
            proxy_set_header Accept-Encoding "";
            proxy_redirect off;
            proxy_buffering off;
            # Home Assistant renders ingress panels inside an iframe; MinIO's
            # console sends X-Frame-Options: DENY, which the browser would
            # otherwise honour and refuse to render here at all. Confirmed
            # against a running console — without this the panel is just a
            # blank frame. Safe to drop: nginx and MinIO are the same origin
            # as far as the browser is concerned either way.
            proxy_hide_header X-Frame-Options;
        }
    }
}
